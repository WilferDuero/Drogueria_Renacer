{
    "expo":  {
                 "name":  "Drogueria Renacer Admin",
                 "slug":  "drogueria-renacer-admin",
                 "version":  "1.0.0",
                 "scheme":  "drogueria-renacer-admin",
                 "orientation":  "portrait",
                 "icon":  "./assets/icon.png",
                 "primaryColor":  "#21808d",
                 "userInterfaceStyle":  "light",
                 "newArchEnabled":  false,
                 "splash":  {
                                "image":  "./assets/logo-drogueria.jpg",
                                "resizeMode":  "contain",
                                "backgroundColor":  "#fcfcf9"
                            },
                 "ios":  {
                             "bundleIdentifier":  "com.drogueriarenacer.adminmobile",
                             "supportsTablet":  true
                         },
                 "android":  {
                                 "package":  "com.drogueriarenacer.adminmobile",
                                 "adaptiveIcon":  {
                                                      "foregroundImage":  "./assets/adaptive-icon.png",
                                                      "backgroundColor":  "#fcfcf9"
                                                  },
                                 "edgeToEdgeEnabled":  true,
                                 "predictiveBackGestureEnabled":  false
                             },
                 "web":  {
                             "favicon":  "./assets/favicon.png"
                         },
                 "plugins":  [
                                 "expo-secure-store",
                                 "expo-dev-client",
                                 [
                                     "expo-build-properties",
                                     {
                                         "android":  {
                                                         "ndkVersion":  "26.1.10909125"
                                                     }
                                     }
                                 ]
                             ]
             }
}
